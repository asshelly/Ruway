{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    "jsx": "react-jsx",

    "moduleResolution": "bundler",
    "isolatedModules": true,
    "noEmit": true,

    "skipLibCheck": true,

    "strict": true,
    "forceConsistentCasingInFileNames": true,

    "types": ["node"],

    "baseUrl": ".",

    "paths": {
      "@/*": ["./*"]
    },

    "allowJs": false,
    "allowImportingTsExtensions": true,
    "moduleDetection": "auto"
  },

  "include": ["./**/*"],
  "exclude": ["node_modules", "dist"]
}